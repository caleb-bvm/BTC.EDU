DJANGO_DEBUG=true
DJANGO_SECRET_KEY=GENERAR_EN_SETUP
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# SQLite local en src/.local/platform.sqlite3; no requiere servidor ni credenciales.
# Ejecuta scripts/setup-commerce.py con LNbits local activo para preparar
# .local/commerce.env (ignorado por Git). FakeWallet local es el modo inicial.
# COMMERCE_SIMULATION=false desactiva explícitamente cualquier pago de prueba.
# LNBITS_URL=http://127.0.0.1:5000
# LNBITS_INVOICE_KEY=
# LNBITS_PAYER_KEY=
# LNBITS_ADMIN_TOKEN=
# Para pagar con ZEUS/Polar: ejecuta scripts/setup-commerce-regtest.py.
# COMMERCE_PAYMENT_MODE=regtest utiliza LNbits local en el puerto 5001.
# No requiere extensiones de LNbits. Las claves permanecen en el servidor.
