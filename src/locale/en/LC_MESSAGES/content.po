msgstr "-o, -s and -w for quick checks."

msgid "-p 8000:8000 conecta el puerto de tu equipo con el del contenedor."
msgstr "-p 8000:8000 connects your machine's port to the container's."

msgid "-w \"%{http_code}\" imprime solo el número del estado."
msgstr "-w \"%{http_code}\" prints only the status number."

