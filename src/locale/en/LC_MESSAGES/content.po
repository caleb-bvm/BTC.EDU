msgstr "Verify facts, manage risks and set usage rules for a team."

msgid "Verifica la red por tu cuenta con un nodo propio."
msgstr "Verify the network yourself with your own node."

msgid "Verifica una descarga con SHA-256"
msgstr "Verify a download with SHA-256"

msgid "Verificación en dos pasos y llaves de acceso"
msgstr "Two-step verification and passkeys"

msgid "Verificación, publicación y autoevaluación"
msgstr "Verification, publication and self-assessment"

